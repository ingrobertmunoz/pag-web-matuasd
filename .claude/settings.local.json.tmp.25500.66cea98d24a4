{
  "permissions": {
    "allow": [
      "WebFetch(domain:skills.sh)",
      "Bash(python3 -m http.server 8000)",
      "Bash(lsof -ti:8000)",
      "Bash(python3 -m http.server 8001)",
      "Bash(echo \"PID: $!\")",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:8000/)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "Bash(cd *)",
      "Bash(python3 tools/sync-og-tags.py)",
      "Bash(python3 tools/sync-og-tags.py --check)",
      "Bash(git checkout *)",
      "Bash(grep -n '^#\\\\{1,3\\\\} ' CLAUDE.md)",
      "Bash(python3 -)",
      "Bash(python3 tools/generate-og-images.py --force --only calculo-1)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  }
}
